# Copy to .env and fill in. Never commit the real .env.

# Postgres in Docker Compose; swap for sqlite:///./uptime.db to run without Docker.
DATABASE_URL=postgresql://uptime:uptime@db:5432/uptime

# Slack Incoming Webhook. Leave blank to log alerts instead of sending them,
# which is what the test suite and local development do.
# Create one at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Consecutive failed checks before a monitor is declared down. Above 1 so a
# single blip does not page anyone.
FAILURE_THRESHOLD=3

# Seconds between scheduler ticks (how often it looks for due monitors).
SCHEDULER_TICK_SECONDS=5

# Default per-monitor settings applied when not specified.
DEFAULT_INTERVAL_SECONDS=60
DEFAULT_TIMEOUT_SECONDS=10
